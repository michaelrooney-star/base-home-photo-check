{
  "name": "base-home-photo-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 0.0.0.0\" \"tsx server/dev.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:api": "tsx server/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "postinstall": "node scripts/copy-opencv.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.11.0-release.1",
    "hono": "^4.6.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
